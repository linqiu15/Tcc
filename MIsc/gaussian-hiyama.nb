Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"VMatfuncsq", "[", 
    RowBox[{"\[Nu]n1_", ",", "\[Nu]n2_", ",", "l_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"l", "+", 
      FractionBox["3", "2"]}], 
     RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}]], "*", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", 
        SqrtBox[
         RowBox[{"\[Nu]n1", "*", "\[Nu]n2"}]]}], 
       RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}]], ")"}], 
     RowBox[{"l", "+", 
      FractionBox["3", "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VMatfunccolumb", "[", 
    RowBox[{"\[Nu]n1_", ",", "\[Nu]n2_", ",", "l_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["2", 
     SqrtBox["\[Pi]"]], "*", 
    FractionBox[
     RowBox[{
      SuperscriptBox["2", "l"], "*", 
      RowBox[{"Factorial", "[", "l", "]"}]}], 
     RowBox[{"Factorial2", "[", 
      RowBox[{
       RowBox[{"2", "*", "l"}], "+", "1"}], "]"}]], 
    SqrtBox[
     RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}]], "*", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", 
        SqrtBox[
         RowBox[{"\[Nu]n1", "*", "\[Nu]n2"}]]}], 
       RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}]], ")"}], 
     RowBox[{"l", "+", 
      FractionBox["3", "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VMatfuncexp", "[", 
    RowBox[{"\[Nu]n1_", ",", "\[Nu]n2_", ",", "l_", ",", "\[Mu]_"}], "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"2", 
       SqrtBox[
        RowBox[{"\[Nu]n1", "*", "\[Nu]n2"}]]}], 
      RowBox[{"\[Nu]n1", "+", "\[Nu]n2", "+", "\[Mu]"}]], ")"}], 
    RowBox[{"l", "+", 
     FractionBox["3", "2"]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8449386899182935`*^9, 3.844938890053458*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"fa840f0b-88fb-463b-80f1-566c2b391369"],


Cell[CellGroupData[{

Cell["DiagonalMatrix stuff in gaussian basises", "Subsection",
 CellChangeTimes->{{3.8449381960809255`*^9, 
  3.844938218253578*^9}},ExpressionUUID->"686d4ede-22b8-4b1c-95bf-\
3f53474f087d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NMatfunc", "[", 
    RowBox[{"\[Nu]n1_", ",", "\[Nu]n2_", ",", "l_"}], "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"2", 
       SqrtBox[
        RowBox[{"\[Nu]n1", "*", "\[Nu]n2"}]]}], 
      RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}]], ")"}], 
    RowBox[{"l", "+", 
     FractionBox["3", "2"]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TMatfunc", "[", 
     RowBox[{
     "\[Nu]n1_", ",", "\[Nu]n2_", ",", "l_", ",", "\[Mu]_", ",", "hbar_"}], 
     "]"}], ":=", 
    RowBox[{
     FractionBox[
      SuperscriptBox["hbar", "2"], "\[Mu]"], "*", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "l"}], "+", "3"}], ")"}], "*", "\[Nu]n1", "*", 
       "\[Nu]n2"}], 
      RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}]], "*", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"2", 
         SqrtBox[
          RowBox[{"\[Nu]n1", "*", "\[Nu]n2"}]]}], 
        RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}]], ")"}], 
      RowBox[{"l", "+", 
       FractionBox["3", "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"VMatfunc", "[", 
     RowBox[{"\[Nu]n1_", ",", "\[Nu]n2_", ",", "V_", ",", "l_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Nfunc", "[", 
      RowBox[{"\[Nu]n1", ",", "l"}], "]"}], "*", 
     RowBox[{"Nfunc", "[", 
      RowBox[{"\[Nu]n2", ",", "l"}], "]"}], "*", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["r", 
         RowBox[{"2", "*", "l"}]], "*", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}], ")"}]}], "*", 
          SuperscriptBox["r", "2"]}]], "*", 
        RowBox[{"V", "[", "r", "]"}], "*", 
        SuperscriptBox["r", "2"]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VMatfunc", "[", 
    RowBox[{"\[Nu]n1_", ",", "\[Nu]n2_", ",", "V_", ",", "l_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Nfunc", "[", 
     RowBox[{"\[Nu]n1", ",", "l"}], "]"}], "*", 
    RowBox[{"Nfunc", "[", 
     RowBox[{"\[Nu]n2", ",", "l"}], "]"}], "*", 
    RowBox[{"Quiet", "[", 
     RowBox[{"Integauss1d", "[", 
      RowBox[{"Function", "[", 
       RowBox[{"r", ",", 
        RowBox[{
         SuperscriptBox["r", 
          RowBox[{"2", "*", "l"}]], "*", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"\[Nu]n1", "+", "\[Nu]n2"}], ")"}]}], "*", 
           SuperscriptBox["r", "2"]}]], "*", 
         RowBox[{"V", "[", "r", "]"}], "*", 
         SuperscriptBox["r", "2"]}]}], "]"}], "]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.844938224446664*^9, 3.8449383116925116`*^9}, {
   3.8449383432198153`*^9, 3.844938355044979*^9}, {3.8449383856122437`*^9, 
   3.8449384428324203`*^9}, {3.844938475342267*^9, 3.8449386415951977`*^9}, {
   3.844939349882721*^9, 3.8449393793929243`*^9}, 3.8449395401986294`*^9, {

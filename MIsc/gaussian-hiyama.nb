Cell[CellGroupData[{

Cell["gaussian expansion method", "Subsubsection",
 CellChangeTimes->{{3.845526098975952*^9, 
  3.8455261071808553`*^9}},ExpressionUUID->"8df7d660-295a-4ed9-bede-\
4a922c20338b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Nhe4", "=", "60"}], ";"}]], "Input",
 CellChangeTimes->{{3.845526121570777*^9, 3.8455261270108595`*^9}, 
   3.8455266315209293`*^9},
 CellLabel->"In[27]:=",ExpressionUUID->"0a0776be-0108-4bc8-b09e-c5a662cc02c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"potentialhe4", "[", "r_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rm", "=", "2.9673"}], ",", 
      RowBox[{"\[Epsilon]", "=", "10.8"}], ",", 
      RowBox[{"A", "=", "0.5448504*^6"}], ",", 
      RowBox[{"\[Alpha]", "=", "13.353384"}], ",", 
      RowBox[{"C6", "=", "1.3732412"}], ",", 
      RowBox[{"C8", "=", "0.4253785"}], ",", 
      RowBox[{"C10", "=", "0.178100"}], ",", 
      RowBox[{"D", "=", "1.241314"}], ",", "x", ",", "F"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", 
      FractionBox["r", "rm"]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"F", "[", "x", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"x", "<", "D"}], ",", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "/", "x"}], "-", "1"}], ")"}], "2"]}]], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"A", "*", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[Alpha]"}], "*", "x"}]]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"C6", "/", 
            RowBox[{"x", "^", "6"}]}], "+", 
           RowBox[{"C8", "/", 
            RowBox[{"x", "^", "8"}]}], "+", 
           RowBox[{"C10", "/", 
            RowBox[{"x", "^", "10"}]}]}], ")"}], "*", 
         RowBox[{"F", "[", "x", "]"}]}]}], ")"}]}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 CellChangeTimes->{{3.845526136470872*^9, 3.8455262907111173`*^9}, {
  3.8455263314108133`*^9, 3.8455265260909686`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"11ac6d6c-f6f5-4fc7-ade6-ad4569d72fa4"],

